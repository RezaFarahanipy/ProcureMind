# کپی کنید به .env و در صورت نیاز تغییر دهید (start_app.bat آن را می‌خواند)
QWEN_URL=http://127.0.0.1:8080
OCR_URL=http://127.0.0.1:8081
# 0 = Qwen بدون حالت thinking (روی CPU سریع‌تر)
QWEN_THINKING=0
OCR_PROMPT=Extract the text content from this image.
OCR_MAX_SIDE=1000
OCR_PDF_DPI=130
OCR_MAX_PAGES=10
OCR_MAX_TOKENS=4096
HOST=127.0.0.1
PORT=8000
